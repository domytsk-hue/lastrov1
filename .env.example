# ─────────────────────────────────────────────────────────────────────────────
# Lastro — environment. Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* variables reach the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (affiliate links, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://lastro.example.com

# Supabase Postgres connection string (Settings → Database → Connection string).
# Use the transaction pooler (port 6543) on serverless hosts. Without it, development
# uses an embedded Postgres in .data/ (never in production).
DATABASE_URL=

# ── Centralis Hub ────────────────────────────────────────────────────────────
# false = Lastro runs exactly as before; events are kept (except analytics) but not sent.
CENTRALIS_ENABLED=false
# Centralis Hub site (events go to $CENTRALIS_API_URL/api/v1/events). No trailing slash.
CENTRALIS_API_URL=https://hub.centralis.example
# The id Centralis gives the Lastro system (sent with commands it signs).
CENTRALIS_PRODUCT_ID=
# Integration key generated in Centralis for the Lastro system: cx_live_xxxxxxxxxxxx.<secret>
CENTRALIS_API_KEY=
# Shared secret Centralis uses to sign the commands it sends to Lastro.
CENTRALIS_WEBHOOK_SECRET=
CENTRALIS_SCHEMA_VERSION=1.0
CENTRALIS_TIMEOUT_MS=8000

# Bearer token for the scheduler that drains the outbox
# (GET /api/integrations/centralis/outbox/flush). Vercel Cron sends it automatically.
CRON_SECRET=

# ── Payments and plan access (see docs/payments.md) ──────────────────────────
# "on" = paid modules require a plan (sign-up goes to /checkout). Unset = everyone uses the
# app, exactly as before. Turn on only after a real gateway is connected and validated.
LASTRO_PAYWALL=
# Gateway used for new checkouts: "kirvano" in production. Empty (or Kirvano not fully
# configured below) = "payments unavailable" (nothing is charged or stored).
PAYMENT_PROVIDER=

# ── Kirvano (PAYMENT_PROVIDER=kirvano) — see docs/payments.md ──────────────────
# Secret shared with the Kirvano webhook (Token field, and ?token= in the webhook URL).
# At least 16 characters. Server-only.
KIRVANO_WEBHOOK_TOKEN=
# Payment page (checkout link) of each offer, https://pay.kirvano.com/...
KIRVANO_CHECKOUT_URL_MENSAL=
KIRVANO_CHECKOUT_URL_VITALICIO=
# Offer ids (products[].offer_id in Kirvano's webhooks). Strongly recommended: a sale of any
# other offer or product then never releases access.
KIRVANO_OFFER_ID_MENSAL=
KIRVANO_OFFER_ID_VITALICIO=
# "true" when the Mensal offer is a Kirvano subscription (Kirvano charges every month).
KIRVANO_MENSAL_RECORRENTE=
# Development/test gateway: webhooks signed with this secret. Only works without
# DATABASE_URL (isolated environments) — never next to the production database.
PAYMENT_SANDBOX_SECRET=
